# Engagement run artifacts (UUID-named report dumps emitted by the pipeline)
report_*.json
report_*.md

# Claude Code local scheduler lock
.claude/scheduled_tasks.lock

# Claude Code per-developer settings (*.local.* is a personal override — never tracked;
# shared project settings live in the tracked .claude/settings.json)
.claude/settings.local.json

# Docker
docker/volumes/

# Fixtures (large tool outputs, keep sample fixtures in tests/fixtures/)
tests/fixtures/real_outputs/

# Windows
nul

# sqlmap temp output. The bare form covers a sane run; the escaped form covers
# the case where a Windows host path is passed to sqlmap running INSIDE the
# tools container, which then creates a single directory literally named
# "C:\Users\...\Temp\sqlmap_xxxx" in the repo root.
sqlmap_*/
*sqlmap_*/

