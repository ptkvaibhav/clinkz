# Legacy top-level LLM provider — openai | anthropic | gemini | ollama.
# Per-agent providers (LLM_PROVIDER_<AGENT>) and LLM_PROVIDER_DEFAULT below take
# precedence. Under routing v2 every one of them defaults to anthropic.
LLM_PROVIDER=anthropic

# --- PROVIDER ROUTING v2 ---
# Anthropic is priority 1 for EVERY call on EVERY phase. Gemini / OpenAI /
# anything else are FALLBACK ONLY, and a fallback is a disqualifying event, not
# a preference: in baseline mode it fails the run, and in client mode it stamps
# the report provider_degraded and marks the run permanently ineligible as a
# baseline. See docs/provider-routing.md.
#
# Priority is declared in config (Settings.llm_provider_priority) and is NOT
# inferred from which keys you happen to have. A key discovered below makes a
# provider AVAILABLE; it never gives it a position in the chain.

# Run mode — "client" (default) or "baseline".
#   client   : complete the run, stamp any fallback, mark it baseline-ineligible
#   baseline : a fallback on any decision path is a HARD FAILURE (a ladder
#              served by two models is not a ladder)
CLINKZ_RUN_MODE=client

# Model selection (override defaults)
ORCHESTRATOR_MODEL=gpt-4o
AGENT_MODEL=gpt-4o-mini
# Anthropic model — optional, defaults to claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5

# Gemini model for every Gemini-backed call — i.e. every call that fell back.
# Pin the EXACT string, never a floating alias: an alias moves under a fixed
# configuration and silently re-baselines every number the run contributes.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_RESEARCH_MODEL=gemini-3.7-flash

# Gemini 3.x thinking level — LOW | MEDIUM | HIGH (MEDIUM is the API default).
# 3.x replaced the integer thinking_budget with this string enum. MINIMAL is
# offered by the SDK enum and REJECTED by the API on 3.7 Flash, so clinkz
# refuses it at config time rather than mid-engagement.
GEMINI_THINKING_LEVEL=MEDIUM

# Per-agent provider overrides. All anthropic by default; this is the seam for
# moving ONE role deliberately, and doing so does not exempt it from the
# fallback disqualification above.
# LLM_PROVIDER_RESEARCH=anthropic
# LLM_PROVIDER_EXPLOIT=anthropic

# Gemini call-rate ceiling (requests/minute, per client). Default sized for
# Gemini API Tier 1; lower it on the free tier to avoid 429s.
GEMINI_MAX_RPM=30

# Hard wall-clock budget (seconds) for the Research phase. Research returns
# whatever techniques it has gathered once this elapses.
RESEARCH_TIME_BUDGET=180

# --- API Keys (auto-detected) ---
# Convention: <PROVIDER>_API_KEY, with an optional <PROVIDER>_MODEL. Clinkz
# discovers these at startup, validates each one with a cheap call, reports
# which passed, and registers every one of them with the redaction chokepoint
# so no key can reach an artifact or a log line. An API key has no distinctive
# shape, so the shape rules cannot catch it — intake registration is the only
# thing that does.
#
# ANTHROPIC_API_KEY is required in practice: it is priority 1 for every call.
# The others are fallback only. If NO key is present at all, clinkz fails at
# startup naming these variables.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...

# Gemini legacy alias — GEMINI_API_KEY is preferred.
GOOGLE_API_KEY=AIza...

# Skip the startup key-validation probes (they cost one cheap call per key).
# CLINKZ_VALIDATE_KEYS=false

# Ollama (local models, no key required). Not yet in the fallback chain —
# the client is a stub until fully implemented.
OLLAMA_BASE_URL=http://localhost:11434

# State store
DB_PATH=clinkz.db

# Tool execution timeout in seconds
TOOL_TIMEOUT=300

# Tool execution mode — "local" (run tools on host) or "docker" (sandboxed)
TOOL_EXEC_MODE=local

# Docker container name (only used when TOOL_EXEC_MODE=docker)
DOCKER_CONTAINER=clinkz-tools

# Orchestrator LLM provider override (defaults to LLM_PROVIDER if unset)
# ORCHESTRATOR_LLM_PROVIDER=openai

# MCP servers — JSON list of server commands or URLs
# stdio command: ["burpsuite-mcp"]  or  ["python", "/path/to/server.py"]
# HTTP/SSE URL:  ["http://localhost:8080/mcp"]
# Multiple:      ["burpsuite-mcp", "http://localhost:9000/mcp"]
MCP_SERVERS=[]
