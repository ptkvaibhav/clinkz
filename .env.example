# Legacy top-level LLM provider (last-resort fallback) — openai | anthropic | gemini | ollama.
# Per-agent providers (LLM_PROVIDER_<AGENT>) and LLM_PROVIDER_DEFAULT below take precedence.
LLM_PROVIDER=gemini

# Model selection (override defaults)
ORCHESTRATOR_MODEL=gpt-4o
AGENT_MODEL=gpt-4o-mini
# Gemini model for Recon / Scan / Report (and Exploit's Gemini fallback) —
# GA only. Do NOT set the shut-down gemini-3.1-flash-lite-preview here.
GEMINI_MODEL=gemini-3.1-flash-lite
# Gemini model for Research — GA only. Do NOT set the shut-down
# gemini-3.1-flash-lite-preview here.
GEMINI_RESEARCH_MODEL=gemini-3.1-flash-lite

# Anthropic model — optional, defaults to claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Per-agent provider overrides. Research runs on Gemini Flash-Lite by default;
# Exploit is pinned to Anthropic. Uncomment to change.
# LLM_PROVIDER_RESEARCH=gemini
# LLM_PROVIDER_EXPLOIT=anthropic

# Gemini call-rate ceiling (requests/minute, per client). Default sized for
# Gemini API Tier 1; lower it on the free tier to avoid 429s.
GEMINI_MAX_RPM=30

# Hard wall-clock budget (seconds) for the Research phase. Research returns
# whatever techniques it has gathered once this elapses.
RESEARCH_TIME_BUDGET=180

# --- API Keys ---
# At least one must be set. For resilience, set both so the fallback chain
# has somewhere to go when a provider rate-limits or times out.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Optional third provider in the fallback chain.
OPENAI_API_KEY=sk-...

# Gemini legacy alias — GEMINI_API_KEY is preferred.
GOOGLE_API_KEY=AIza...

# Ollama (local models, no key required). Not yet in the fallback chain —
# the client is a stub until fully implemented.
OLLAMA_BASE_URL=http://localhost:11434

# State store
DB_PATH=clinkz.db

# Tool execution timeout in seconds
TOOL_TIMEOUT=300

# Tool execution mode — "local" (run tools on host) or "docker" (sandboxed)
TOOL_EXEC_MODE=local

# Docker container name (only used when TOOL_EXEC_MODE=docker)
DOCKER_CONTAINER=clinkz-tools

# Orchestrator LLM provider override (defaults to LLM_PROVIDER if unset)
# ORCHESTRATOR_LLM_PROVIDER=openai

# MCP servers — JSON list of server commands or URLs
# stdio command: ["burpsuite-mcp"]  or  ["python", "/path/to/server.py"]
# HTTP/SSE URL:  ["http://localhost:8080/mcp"]
# Multiple:      ["burpsuite-mcp", "http://localhost:9000/mcp"]
MCP_SERVERS=[]
